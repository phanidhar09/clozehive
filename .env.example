# ─────────────────────────────────────────────────────────────
#  CLOZEHIVE — Root environment variables
#  Copy this file to .env and fill in your values.
#  Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────
FRONTEND_PORT=3000
API_GATEWAY_PORT=8000
AI_AGENT_PORT=8001

# ── Derived service URLs ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
AI_AGENT_URL=http://localhost:8001

# ── OpenAI ───────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Security ─────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-64-character-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────
# Get credentials at https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web Application type), then add:
#   Authorised JavaScript origins: http://localhost:3000
#   Authorised redirect URIs:      http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ── Data stores ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clozehive:clozehive@localhost:5433/clozehive
REDIS_URL=redis://localhost:6380/0

# ── Vector search (FAISS) ────────────────────────────────────
# FAISS provides local in-process vector similarity for AI recommendations
FAISS_ENABLED=true
FAISS_DIMENSION=1536
FAISS_INDEX_PATH=./data/faiss/index.bin
FAISS_ID_MAP_PATH=./data/faiss/id_map.json
FAISS_SAVE_INTERVAL_SECONDS=60
VECTOR_SEARCH_LIMIT=8
VECTOR_SCORE_THRESHOLD=0.78

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Stores: closet items, follows, groups (users/auth stay in Postgres)
#
# Option A — paste the entire service account JSON as a single-line string:
FIREBASE_CREDENTIALS_JSON=
#
# Option B — point to a downloaded service account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Get credentials: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Kafka / Redpanda ──────────────────────────────────────────
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_MS=604800000
KAFKA_HOST_PORT=19092
REDPANDA_CONSOLE_HOST_PORT=8080
