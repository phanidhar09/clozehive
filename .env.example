# ─────────────────────────────────────────────────────────────
#  CLOZEHIVE — Root environment variables
#  Copy to `.env` and fill in secrets. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────
FRONTEND_PORT=3000
API_GATEWAY_PORT=8000
AI_AGENT_PORT=8001
POSTGRES_HOST_PORT=5433
# Use 6382 by default to avoid clashing with other stacks that map Redis to 6380 on the host.
REDIS_HOST_PORT=6382

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
AI_AGENT_URL=http://localhost:8001

# ── Phase 1 frontend (hide Groups / Avatar / AI Stylist; Outfit Builder stays in MVP)
VITE_HIDE_NON_MVP=true

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=clozehive
POSTGRES_PASSWORD=clozehive
POSTGRES_DB=clozehive
DATABASE_URL=postgresql+asyncpg://clozehive:clozehive@localhost:5433/clozehive

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6382/0
# Set false for local runs without Redis (skips Redis in /health and /ready)
REDIS_CHECK_ON_READY=true

# ── Security ─────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
ENVIRONMENT=development
DEBUG=false

# ── Google OAuth ─────────────────────────────────────────────
# Redis must be running: OAuth CSRF state is stored in Redis. Wrong REDIS_URL ⇒ sign-in fails.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Browser redirect after tokens are issued — must match where the frontend runs (e.g. Docker: http://localhost:3001).

# ── AI providers (OpenAI only — chat, vision, embeddings) ───
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENWEATHER_API_KEY=44334d77c6d0109081e66770345ed04ee6c33
EMBEDDING_MODEL=text-embedding-ada-002
AI_CACHE_TTL=600
AI_CACHE_ENABLED=true
GEMINI_API_KEY=AIzaSyBxHSwcyWeLNIh6zmqdOp6rMMRV41PJr8k
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=1024

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=

# ── Google Cloud Storage (persistent image storage) ─────────
# Set GCS_BUCKET_NAME to enable GCS uploads; leave blank for local disk (dev only).
# Bucket must have allUsers → roles/storage.objectViewer for public image URLs.
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
# Paste the full service-account JSON here, or leave blank to use
# GOOGLE_APPLICATION_CREDENTIALS / Application Default Credentials.
GCS_CREDENTIALS_JSON=

# ── Optional Firebase / Firestore (non–Phase 1 paths) ───────
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# ── Kafka (optional local stack) ─────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
