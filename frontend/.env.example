# ClozeHive frontend (Vite) — copy to frontend/.env for local overrides.
#
# Build-time embedding: VITE_* vars are baked in at `npm run build`.
# In Docker, pass the same vars as build args or runtime env.
#
# Full reference: ../docs/ENVIRONMENT.md

# VITE_API_URL: leave unset when the SPA is served with /api + /uploads proxied to the gateway
# (Docker frontend image, or Vite dev with root .env empty). Only set when the API is on
# another origin, e.g. host dev → http://localhost:8000 or https://api.example.com

# Phase 1: hide non-MVP nav (Groups, Avatar, AI Stylist). Outfit Builder stays visible.
VITE_HIDE_NON_MVP=true

# ── Observability (Sentry error tracking + Web Vitals) ───────
# Browser DSN — blank disables all frontend tracking (observability.ts no-ops).
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload at build time (optional) — set all three to enable.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
