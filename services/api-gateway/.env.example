# API Gateway environment template.
# Copy to services/api-gateway/.env for service-local development, or set these in the root .env for Compose.

# PostgreSQL SQLAlchemy URL. Contains the database password; create the password locally or in your database provider.
DATABASE_URL=postgresql+asyncpg://app_user:replace-with-database-password@localhost:5432/clozehive

# Database pool settings. Tune upward only after checking database connection limits.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Redis connection URL for cache and refresh-token sessions.
REDIS_URL=redis://localhost:6379

# JWT signing secret. Generate a random 64+ character value with a password manager or `openssl rand -hex 32`.
JWT_SECRET=replace-with-random-64-character-secret

# Google OAuth client ID. Create it in Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth client secret. Get it from the same Google Cloud OAuth client.
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Google OAuth redirect URI. Must exactly match Google Cloud Console, with no trailing slash.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URL used after OAuth redirects.
FRONTEND_URL=http://localhost:3000

# Comma-separated CORS origins allowed in addition to localhost dev ports.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OpenAI API key for AI features that call OpenAI. Create one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-replace-with-openai-api-key

# Anthropic API key for direct ClosetIQ chat. Create one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=sk-ant-replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# External API Keys (consolidated from MCP services)
OPENWEATHER_API_KEY=
OPENAI_API_KEY=sk-replace-with-openai-api-key
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-ada-002
AI_CACHE_TTL=600
AI_CACHE_ENABLED=true

# Optional Firebase service account JSON. Get it from Firebase Console > Project Settings > Service accounts.
FIREBASE_CREDENTIALS_JSON=

# Optional Sentry DSN for error reporting. Create it in Sentry project settings.
SENTRY_DSN=
