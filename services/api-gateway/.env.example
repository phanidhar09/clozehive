# API Gateway — environment template
#
# Usage:
#   • Docker Compose: prefer the **repo root** `.env` (see root `.env.example`); Compose forwards vars into this service.
#   • Local `uvicorn` from this directory: copy to `services/api-gateway/.env` OR rely on repo root `.env` (Settings loads root first).
#
# Full reference: ../../docs/ENVIRONMENT.md

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clozehive:clozehive@localhost:5433/clozehive

REDIS_URL=redis://localhost:6382/0

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie settings for HttpOnly refresh-token cookie
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=Strict in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

ENVIRONMENT=development
DEBUG=false

# OpenAI — chat, vision, embeddings (see app/core/config.py)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024

# Anthropic Claude (used by AI stylist chat agent)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=2048

# Background-removal service (optional — leave blank to skip)
REMBG_API_KEY=

# ── Google Cloud Storage (optional — leave bucket empty for local disk) ─────
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CREDENTIALS_FILE=
GCS_CREDENTIALS_JSON=

# ── Database pool ───────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30

# ── Redis behavior ──────────────────────────────────────────────────────────
REDIS_CHECK_ON_READY=true
CLOSET_PREVIEW_TTL_SECONDS=3600

# ── Kafka / async AI (optional) ───────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CLIENT_ID=clozehive-api-gateway
KAFKA_RESULT_GROUP_ID=clozehive-api-gateway-results

# ── Uploads & models ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
EMBEDDING_MODEL=text-embedding-ada-002
# Optional Gemini vision path — leave GEMINI_API_KEY empty for OpenAI-only vision.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENWEATHER_API_KEY=
# Tavily web search — live destination dress guidelines (empty = disabled, static fallbacks apply)
TAVILY_API_KEY=

AI_CACHE_ENABLED=true
AI_CACHE_TTL=600

# ── Rate limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=20/minute

# ── Firebase (optional) ─────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_METRICS=true
SENTRY_DSN=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clozehive1
