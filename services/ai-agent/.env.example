# AI Agent (FastAPI + LangGraph) — optional service.
#
# Started with: docker compose --profile ai up
# Or run locally from services/ai-agent with this file as .env
#
# Full reference: ../../docs/ENVIRONMENT.md

ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8001

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE_URL=https://api.openai.com/v1

# LLM-only agent when false; set true only if MCP services are reachable (legacy-mcp profile).
ENABLE_MCP_TOOLS=false
MCP_WEATHER_URL=http://mcp-weather:8010/sse
MCP_VISION_URL=http://mcp-vision:8011/sse
MCP_OUTFIT_URL=http://mcp-outfit:8012/sse
MCP_PACKING_URL=http://mcp-packing:8013/sse

# Same Postgres as gateway; use host ports when running agent on host:
# postgresql://clozehive:clozehive@localhost:5433/clozehive
DATABASE_URL=postgresql://clozehive:clozehive@postgres:5432/clozehive

REDIS_URL=redis://redis:6379/1

VECTOR_STORE=pgvector
VECTOR_SEARCH_LIMIT=8
VECTOR_SCORE_THRESHOLD=0.78

AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60
AGENT_TEMPERATURE=0.7

ALLOWED_ORIGINS=http://api-gateway:8000,http://localhost:8000

CACHE_TTL_AGENT=300

RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT=1.0
RETRY_MAX_WAIT=8.0
