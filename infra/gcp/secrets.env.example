# Copy to secrets.env and fill in. `01-secrets.sh` reads this and pushes each
# value into Google Secret Manager. secrets.env is gitignored — never commit it.

# ── Databases (Neon — create TWO databases/branches, one per service group) ──
# Format: postgresql://USER:PASS@HOST/DB?sslmode=require
# The services rewrite the scheme to postgresql+asyncpg automatically.
DB_URL_CORE=postgresql://user:pass@ep-xxx.neon.tech/clozehive_core?sslmode=require

# ── Redis (Upstash — create TWO databases) ──────────────────────────────────
# Cache = evictable (allkeys-lru). State = non-evictable (noeviction).
# Format: rediss://default:PASSWORD@HOST:PORT
REDIS_CACHE_URL=rediss://default:xxx@xxx.upstash.io:6379
REDIS_STATE_URL=rediss://default:yyy@yyy.upstash.io:6379

# ── App secrets ──────────────────────────────────────────────────────────────
# JWT_SECRET + INTERNAL_SERVICE_TOKEN must be shared, byte-identical, across
# api-gateway / worker. Generate with: openssl rand -hex 32
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

# ── Third-party keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
